# Instalación (RN-S1, RN-S2)
PAIS_INSTALACION=CO
VERSION_REGLAS=8

# Base de datos: PostgreSQL. Con docker compose apunta al servicio db; en local, a localhost:5432.
DATABASE_URL=postgresql+psycopg://mediflow:mediflow@db:5432/mediflow
STORAGE_LOCAL_DIR=./storage

# LLM externo (RN-M10). Nunca se versiona la clave real. LLM_PROVEEDOR: openai (por defecto) | gemini
LLM_PROVEEDOR=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4.1-mini
PROMPT_VERSION=triaje_v1

# OCI Object Storage (RN-G1). Un solo bucket, prefijo co/
OCI_BUCKET=mediflow
OCI_NAMESPACE=
OCI_REGION=

# Cloudflare R2 del equipo (opcional). Con STORAGE_BACKEND=r2 se usa en lugar de OCI o de la carpeta local.
# Las credenciales nunca se versionan. R2_PREFIJO es la carpeta propia de este sistema dentro del bucket compartido.
STORAGE_BACKEND=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_PREFIJO=mediflow-triaje

# Slack por webhooks (RN-F1, RN-F3). Cada direccion es un secreto. Sin ellas, el canal Slack cuenta como caido (RN-P7).
# general: avisos de nivel Urgente al solicitante. urgente: alertas criticas y sus escalamientos.
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_URL_URGENTE=

# RN-S3: requisitos de puesta en marcha (se ven en Administracion)
BASE_LEGAL_TRATAMIENTO=
CONTRATO_TRANSMISION_INTERNACIONAL=false

# Inicio de sesion (RN-K5): nada se consulta ni se firma sin iniciar sesion. La primera cuenta, de administrador,
# se crea desde la pantalla de ingreso mientras no exista ninguna (RN-S3); tambien sirve el script:
# ADMIN_CLAVE_INICIAL=... python -m scripts.crear_administrador
ADMIN_USUARIO=admin
ADMIN_CLAVE_INICIAL=
NOMBRE_SEDE=Sede principal
