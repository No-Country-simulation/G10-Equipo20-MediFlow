# Instalación (RN-S1, RN-S2)
PAIS_INSTALACION=CO
VERSION_REGLAS=8

# Base de datos
DATABASE_URL=postgresql+psycopg://mediflow:mediflow@db:5432/mediflow

# LLM externo (RN-M10). Nunca se versiona la clave real.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PROMPT_VERSION=triaje_v1

# OCI Object Storage (RN-G1). Un solo bucket, prefijo co/
OCI_BUCKET=mediflow
OCI_NAMESPACE=
OCI_REGION=
