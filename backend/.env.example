# Instalación (RN-S1, RN-S2)
PAIS_INSTALACION=CO
VERSION_REGLAS=8

# Base de datos: PostgreSQL. Con docker compose apunta al servicio db; en local, a localhost:5432.
DATABASE_URL=postgresql+psycopg://mediflow:mediflow@db:5432/mediflow
STORAGE_LOCAL_DIR=./storage

# LLM externo (RN-M10). Nunca se versiona la clave real. LLM_PROVEEDOR: openai (por defecto) | gemini
LLM_PROVEEDOR=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4.1-mini
PROMPT_VERSION=triaje_v1

# OCI Object Storage (RN-G1). Un solo bucket, prefijo co/
OCI_BUCKET=mediflow
OCI_NAMESPACE=
OCI_REGION=

# Cloudflare R2 del equipo (opcional). Con STORAGE_BACKEND=r2 se usa en lugar de OCI o de la carpeta local.
# Las credenciales nunca se versionan. R2_PREFIJO es la carpeta propia de este sistema dentro del bucket compartido.
STORAGE_BACKEND=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_PREFIJO=mediflow-triaje

# RN-S3: requisitos de puesta en marcha (se ven en Administracion)
BASE_LEGAL_TRATAMIENTO=
CONTRATO_TRANSMISION_INTERNACIONAL=false

# Inicio de sesion (RN-K5). En true, nada se consulta ni se firma sin iniciar sesion.
# En false (demostracion), quien no tiene cuenta con clave sigue firmando con su nombre.
EXIGIR_SESION=false
# Primera cuenta de administrador: python -m scripts.crear_administrador (la clave nunca se versiona)
ADMIN_USUARIO=admin
ADMIN_CLAVE_INICIAL=
